cd('C:\CodingProjects\bioctree');
data=getData();

cd('C:\CodingProjects\bioctree');
addpath("gspbox\");
addpath("test-data\");
addpath("gspbox\");
addpath("matlab-toolboxes-master\matlab-toolboxes-master\toolbox_fast_marching\");
Vertices = data.anat.Vertices';       % [15002 x 3] flipped to work with Fast Marching
Faces = data.anat.Faces';             % [29988 x 3]
VertConn=data.anat.VertConn;
nVertices = size(Vertices,2);
nFaces=size(Faces,2);


sourceTS = data.sourceTS;            % [15002 x 9600]
clf;
plot_mesh(Vertices,Faces);
shading interp;


%% 
ptCloud = pcread("teapot.ply");
gridstep = 0.05;
ptCloudDownSampled = pcdownsample(ptCloud,"gridAverage",gridstep);
ptCloudV = pointCloud(anat_high.Vertices);
depth = 6;
mesh = pc2surfacemesh(ptCloudV,"poisson",depth);
surfaceMeshShow(mesh)

%% Verify that the graph is connected
% VertConn: sparse nVertices x nVertices connectivity matrix
G = graph(VertConn);
components = conncomp(G);  % gives component index for each vertex
n_components = max(components);


fprintf('The surface mesh has %d connected components.\n', n_components);

% For each hemisphere/component
hemi1_idx = find(components == 1);
hemi2_idx = find(components == 2);

VertConn1 = VertConn(hemi1_idx, hemi1_idx);
VertConn2 = VertConn(hemi2_idx, hemi2_idx);

G1 = graph(VertConn1);
components1 = conncomp(G1);  % gives component index for each vertex
n_components1 = max(components1)
G2 = graph(VertConn2);
components2 = conncomp(G2);  % gives component index for each vertex
n_components2 = max(components2)

% Extract vertices
Vertices1 = Vertices(:, hemi1_idx);
Vertices2 = Vertices(:, hemi2_idx);
% Build face masks
face_mask1 = all(ismember(Faces, hemi1_idx), 1);
face_mask2 = all(ismember(Faces, hemi2_idx), 1);

Faces1_global = Faces(:, face_mask1);  % global indices
Faces2_global = Faces(:, face_mask2);

% Reindex faces to local vertex indices
[~, loc1] = ismember(Faces1_global(:), hemi1_idx);
Faces1 = reshape(loc1, 3, []);

[~, loc2] = ismember(Faces2_global(:), hemi2_idx);
Faces2 = reshape(loc2, 3, []);

plot_mesh(Vertices1, Faces1);


%%
% load the mesh
[vertex,faces] = read_mesh('elephant-50kv');
% display the mesh
figure(2)
plot_mesh(vertex, faces);
shading interp;
options.nb_iter_max = Inf;
start_points = 7500;
[De,Se,Qe] = perform_fast_marching_mesh(vertex, faces, start_points, options);

%%
max(size(Vertices1,2))
start_points = 6500;
options.nb_iter_max = 1000;
D = perform_fast_marching_mesh(Vertices1, Faces1, start_points, options);

npaths = 30; nverts = size(Vertices1,2);
[tmp,I] = sort( D(:) ); I = I(end:-1:1); I = I(1:round(nverts*1));
end_points = floor( rand(npaths,1)*(length(I)-1) )+1;
end_points = I(end_points);

options.v2v = compute_vertex_ring(Faces1);
options.e2f = compute_edge_face_ring(Faces1);
% extract the geodesics
options.method = 'continuous';
options.verb = 0;
paths = compute_geodesic_mesh(D,Vertices1, Faces1, end_points, options);
% display
options.colorfx = 'equalize';
plot_fast_marching_mesh(Vertices1, Faces1, D, paths, options);
shading interp;

%%
% Build weighted graph
 G=gsp_graph(VertConn);
 G.coords=Vertices';
 [Idx, Gz, bl] = gsp_components(G);

 LG=Gz{1};

 LG = gsp_estimate_lmax(LG);

 Gv=G;

 %% Heat kernel
 G=LG;
 G=Gv;
  G = gsp_estimate_lmax(G);
 taus = [10, 100, 1000, 10000];
Hk = gsp_design_heat(G, taus);

S = zeros(G.N, 1);
vertex_delta = 2000;
S(vertex_delta) = 1;

Sf_vec = gsp_filter_analysis(G, Hk, S);
Sf = gsp_vec2mat(Sf_vec, length(taus));

param_plot.cp = [0.1223, -0.3828, 12.3666];

subplot(221)
gsp_plot_signal(G,Sf(:,1), param_plot);
axis square
title(sprintf('Heat diffusion tau = %d', taus(1)));
subplot(222)
gsp_plot_signal(G,Sf(:,2), param_plot);
axis square
title(sprintf('Heat diffusion tau = %d', taus(2)));
subplot(223)
gsp_plot_signal(G,Sf(:,3), param_plot);
axis square
title(sprintf('Heat diffusion tau = %d', taus(3)));
subplot(224)
gsp_plot_signal(G,Sf(:,4), param_plot);
axis square
title(sprintf('Heat diffusion tau = %d', taus(4)));

%% 
 G=gsp_graph(data.anat.VertConn);
 G.coords=data.anat.Vertices;
 [Idx, Gz, bl] = gsp_components(G);
Gspace=G;

Gspace=Gz{1};
sourceTS = data.IK * F_alpha;
sourceTsShort = sourceTS(Idx==1,1:50);

T=size(sourceTS, 2);
T=size(sourceTsShort, 2)

fs_ds = 300;

G_jtv = gsp_jtv_graph(Gspace, T, fs_ds);
G_jtv = gsp_estimate_lmax(G_jtv);

tau = 10;  % diffusion scale
[g, filterType] = gsp_jtv_design_diffusion(G, tau);
[h,filterType] = gsp_jtv_filter_array(G,g, filterType);

X=sourceTS;
% Signal: size (N x T), e.g., MEG vertex signals over time
[c] = gsp_jtv_filter_analysis(G, h, filterType, X);
Fd = gsp_jtv_compute_frame(G_jtv,jtv_filter);

gsp_plot_jtv_signal(G_jtv,X);
t = gsp_jtv_ta(G_jtv);