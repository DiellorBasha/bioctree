classdef Manifold
    properties
        N (1,1) double {mustBeInteger,mustBeNonnegative} = 0
        Vertices table                  % N rows; user-added vars
        Edges    table                  % vars: EndNodes [M,2], Weight [M,1]
        Faces    table                  % vars: EndNodes [F,3]

        % Auto-computed graph matrices (sparse)
        Adjacency sparse 
        Laplacian sparse 
        Incidence sparse 
        Degree    sparse    % diagonal degree matrix
    end

    methods
        function obj = Manifold(N, topo, weights)
            % Manifold(N, topo, [weights])
            % topo: Mx2 edges OR Fx3 faces (1-based). If faces, edges are derived.
            if nargin < 1 || isempty(N), N = 0; end
            if nargin < 2, topo = []; end

            % Ensure N covers the topology indices (if given)
            if ~isempty(topo)
                N = max(N, max(topo,[],'all'));
            end
            obj.N = N;

            % N-row empty vertex table
            obj.Vertices = table('Size',[N 0],'VariableTypes',{},'VariableNames',{});

            % Init empty edges/faces
            obj.Edges = table(zeros(0,2), zeros(0,1), 'VariableNames',{'EndNodes','Weight'});
            obj.Faces = table(zeros(0,3), 'VariableNames',{'EndNodes'});

            % Fill topology
            if ~isempty(topo)
                topo = double(topo);
                switch size(topo,2)
                    case 2  % edges
                        if nargin < 3 || isempty(weights), weights = ones(size(topo,1),1); end
                        obj.Edges = table(topo, double(weights), 'VariableNames',{'EndNodes','Weight'});

                    case 3  % faces → derive edges (unique, undirected), weight=1
                        obj.Faces = table(topo, 'VariableNames',{'EndNodes'});
                        E = sort([topo(:,[1 2]); topo(:,[2 3]); topo(:,[3 1])],2);
                        E = unique(E,'rows');
                        obj.Edges = table(E, ones(size(E,1),1), 'VariableNames',{'EndNodes','Weight'});

                    otherwise
                        error('Manifold:BadTopo','topo must have 2 (edges) or 3 (faces) columns.');
                end
            end

            % --- Auto-compute graph matrices from Edges ---
            if obj.N > 0
                G = graph(obj.Edges);                 % uses EndNodes, Weight
                obj.Adjacency = adjacency(G);
                obj.Laplacian = laplacian(G);
                obj.Incidence = incidence(G);
                d = degree(G);
                obj.Degree = spdiags(d, 0, obj.N, obj.N);
            else
                % Keep zero-size sparse defaults
                obj.Adjacency = sparse(0,0);
                obj.Laplacian = sparse(0,0);
                obj.Incidence = sparse(0,0);
                obj.Degree    = sparse(0,0);
            end
        end

        % ---- Data adders (scalars Nx1/Mx1/Fx1 or 3-vectors Nx3/Mx3/Fx3) ----
        function obj = addVertexData(obj, name, values)
            obj = addData_(obj, "Vertices", name, values, obj.N);
        end
        function obj = addEdgeData(obj, name, values)
            obj = addData_(obj, "Edges", name, values, height(obj.Edges));
        end
        function obj = addFaceData(obj, name, values)
            obj = addData_(obj, "Faces", name, values, height(obj.Faces));
        end

        % Quick counts
        function n = numVertices(obj), n = obj.N; end
        function m = numEdges(obj),    m = height(obj.Edges); end
        function f = numFaces(obj),    f = height(obj.Faces); end
    end
end

% ----- local helper (kept tiny) -----
function obj = addData_(obj, target, name, values, nRows)
    name = matlab.lang.makeValidName(string(name));
    if size(values,1) ~= nRows
        error('%s row count must be %d.', target, nRows);
    end
    vals = double(values);
    if ~(size(vals,2) == 1 || size(vals,2) == 3)
        error('Values must have 1 or 3 columns.');
    end
    switch target
        case "Vertices", T = obj.Vertices; T.(name) = vals; obj.Vertices = T;
        case "Edges",    T = obj.Edges;    T.(name) = vals; obj.Edges    = T;
        case "Faces",    T = obj.Faces;    T.(name) = vals; obj.Faces    = T;
    end
end
