{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "bct.h5 (flattened top-level) — schema v1.1 (root subject + cohort)",
  "type": "object",

  "root": {
    "file_attributes": {
      "type": "object",
      "properties": {
        "bct_version": { "type": "string" },
        "uuid":        { "type": "string", "description": "File UUID (not subject id)" },
        "created_utc": { "type": "number", "description": "POSIX seconds (UTC)" },
        "generator":   { "type": "string" },
        "space":       { "type": "string", "description": "e.g., subject_native, MNI152" },
        "endian":      { "type": "string", "enum": ["little","big"] },
        "libver":      { "type": "string", "description": "HDF5 lib version bounds" },
        "description": { "type": "string" }
      },
      "required": ["bct_version","uuid","created_utc","generator","space"]
    },

    "subject": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Subject/entity identifier (root attribute 'id')" },
        "attributes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name":  { "type": "string", "description": "Attribute name to be stored at root" },
              "value": { "description": "Scalar JSON value to store as root attribute (string/number/boolean)" },
              "dtype": { "type": "string", "description": "HDF5 atomic type hint (e.g., string,float32,int32,uint8)", "default": "string" },
              "units": { "type": "string" }
            },
            "required": ["name","value"]
          }
        }
      },
      "required": ["id"]
    },

    "cohort": {
      "type": "array",
      "description": "Links to other bct.h5 files that form a cohort",
      "items": {
        "type": "object",
        "properties": {
          "href":       { "type": "string", "description": "Path or URL to another .bct.h5" },
          "uuid":       { "type": "string", "description": "UUID of linked file (if known)" },
          "subject_id": { "type": "string", "description": "Subject id in linked file (if known)" },
          "relation":   { "type": "string", "description": "e.g., same_subject_different_session, same_family, control" },
          "tags":       { "type": "array", "items": { "type": "string" } },
          "notes":      { "type": "string" }
        },
        "required": ["href"]
      }
    }
  },

  "groups": {
    "/signal": {
      "datasets": {
        "/signal/data": {
          "shape": ["S","C","N","T"],
          "dtype": "float32",
          "h5ds_scales": { "0": "/scales/axes/S", "1": "/scales/axes/C", "2": "/scales/axes/N", "3": "/scales/axes/T" },
          "attributes": {
            "dtype_primary": "string",
            "component_semantic": "string"
          },
          "h5p": { "chunk": ["~1","~C","~2048","~1000"], "deflate": 4, "shuffle": true }
        }
      }
    },

    "/manifold": {
      "attributes": { "hemi": "string", "surface": "string" },
      "datasets": {
        "/manifold/vertex": {
          "shape": ["N",3], "dtype": "float32",
          "attributes": { "units": "mm", "space": "RAS" },
          "h5ds_scales": { "0": "/scales/axes/N" },
          "h5p": { "chunk": ["~4096",3], "deflate": 3 }
        },
        "/manifold/face": {
          "shape": ["F",3], "dtype": "uint32",
          "attributes": { "winding": "CCW", "index_base": "int32" },
          "h5ds_scales": { "0": "/scales/axes/F" }
        },
        "/manifold/normals_vertex": {
          "shape": ["N",3], "dtype": "float32",
          "attributes": { "units": "unit-vector" },
          "h5ds_scales": { "0": "/scales/axes/N" },
          "h5p": { "chunk": ["~4096",3], "deflate": 3 }
        },
        "/manifold/normals_face": {
          "shape": ["F",3], "dtype": "float32",
          "attributes": { "units": "unit-vector" },
          "h5ds_scales": { "0": "/scales/axes/F" }
        },
        "/manifold/vertex_curvature": {
          "shape": ["N"], "dtype": "float32",
          "attributes": { "units": "1/mm", "collection": "properties", "domain": "vertex" },
          "h5ds_scales": { "0": "/scales/axes/N" },
          "h5p": { "chunk": ["~16384"], "deflate": 4 }
        },

        "/manifold/adj_indptr": {
          "shape": ["nnz_rows"], "dtype": "int64",
          "attributes": { "csr_shape": ["int64","int64"], "symmetric": "uint8", "collection": "graph" },
          "h5p": { "chunk": ["~32768"], "deflate": 4 }
        },
        "/manifold/adj_indices": {
          "shape": ["nnz"], "dtype": "int32",
          "attributes": { "index_base": "int32", "collection": "graph" },
          "h5p": { "chunk": ["~65536"], "deflate": 4 }
        },
        "/manifold/adj_data": {
          "shape": ["nnz"], "dtype": "float32",
          "attributes": { "meaning": "edge weight", "collection": "graph" },
          "h5p": { "chunk": ["~65536"], "deflate": 4 }
        },

        "/manifold/degree": {
          "shape": ["N"], "dtype": "float32",
          "attributes": { "collection": "graph" },
          "h5ds_scales": { "0": "/scales/axes/N" },
          "h5p": { "chunk": ["~16384"], "deflate": 3 }
        },

        "/manifold/lap_indptr": {
          "shape": ["nnz_rows"], "dtype": "int64",
          "attributes": { "csr_shape": ["int64","int64"], "collection": "graph" },
          "h5p": { "chunk": ["~32768"], "deflate": 4 }
        },
        "/manifold/lap_indices": {
          "shape": ["nnz"], "dtype": "int32",
          "attributes": { "collection": "graph" },
          "h5p": { "chunk": ["~65536"], "deflate": 4 }
        },
        "/manifold/lap_data": {
          "shape": ["nnz"], "dtype": "float32",
          "attributes": { "lap_type": "combinatorial", "collection": "graph" },
          "h5p": { "chunk": ["~65536"], "deflate": 4 }
        },

        "/manifold/eig_vals": {
          "shape": ["K"], "dtype": "float64",
          "attributes": { "collection": "graph" },
          "h5ds_scales": { "0": "/scales/axes/K" },
          "h5p": { "chunk": ["~8192"], "deflate": 3 }
        },
        "/manifold/eig_vecs": {
          "shape": ["N","K"], "dtype": "float32",
          "attributes": { "orthonormal": "uint8", "collection": "graph" },
          "h5ds_scales": { "0": "/scales/axes/N", "1": "/scales/axes/K" },
          "h5p": { "chunk": ["~4096","~32"], "deflate": 4 }
        }
      }
    },

    "/events": {
      "datasets": {
        "/events/id":            { "shape": ["E"], "dtype": "uint64", "h5ds_scales": { "0": "/scales/axes/E" } },
        "/events/s_idx":         { "shape": ["E"], "dtype": "int32",  "h5ds_scales": { "0": "/scales/axes/E" } },
        "/events/c_idx":         { "shape": ["E"], "dtype": "int16",  "h5ds_scales": { "0": "/scales/axes/E" } },
        "/events/t_index":       { "shape": ["E"], "dtype": "int64",  "h5ds_scales": { "0": "/scales/axes/E" } },
        "/events/created_utc":   { "shape": ["E"], "dtype": "float64","h5ds_scales": { "0": "/scales/axes/E" } },
        "/events/t_sec":         { "shape": ["E"], "dtype": "float64","h5ds_scales": { "0": "/scales/axes/E" } },

        "/events/space_repr":    { "shape": ["E"], "dtype": "enum(u8:{vertex,face_bary,xyz})", "h5ds_scales": { "0": "/scales/axes/E" } },
        "/events/spat_kind":     { "shape": ["E"], "dtype": "enum(u8:{none,lap_k,diff_tau,parcel})", "h5ds_scales": { "0": "/scales/axes/E" } },
        "/events/temp_kind":     { "shape": ["E"], "dtype": "enum(u8:{none,freq_hz,band,wav_scale})", "h5ds_scales": { "0": "/scales/axes/E" } },

        "/events/v_index":       { "shape": ["E"], "dtype": "int64",  "h5ds_scales": { "0": "/scales/axes/E" } },
        "/events/f_index":       { "shape": ["E"], "dtype": "int64",  "h5ds_scales": { "0": "/scales/axes/E" } },
        "/events/bc":            { "shape": ["E",3], "dtype": "float32", "h5ds_scales": { "0": "/scales/axes/E" } },
        "/events/xyz":           { "shape": ["E",3], "dtype": "float32", "h5ds_scales": { "0": "/scales/axes/E" } },

        "/events/spat_k":        { "shape": ["E"], "dtype": "int64",  "h5ds_scales": { "0": "/scales/axes/E" } },
        "/events/spat_tau":      { "shape": ["E"], "dtype": "float32","h5ds_scales": { "0": "/scales/axes/E" } },
        "/events/spat_parcel":   { "shape": ["E"], "dtype": "int32",  "h5ds_scales": { "0": "/scales/axes/E" } },

        "/events/freq_hz":       { "shape": ["E"], "dtype": "float32","h5ds_scales": { "0": "/scales/axes/E" } },
        "/events/band_id":       { "shape": ["E"], "dtype": "int16",  "h5ds_scales": { "0": "/scales/axes/E" } },
        "/events/wav_scale":     { "shape": ["E"], "dtype": "float32","h5ds_scales": { "0": "/scales/axes/E" } },

        "/events/quality":       { "shape": ["E"], "dtype": "float32","h5ds_scales": { "0": "/scales/axes/E" } },
        "/events/provenance_id": { "shape": ["E"], "dtype": "uint64","h5ds_scales": { "0": "/scales/axes/E" } },

        "/events/label":         { "shape": ["E"], "dtype": "vlen_utf8", "h5ds_scales": { "0": "/scales/axes/E" } },

        "/events/signal_ref":    { "shape": ["E"], "dtype": "ref_dset_region", "target": "/signal/data",
                                   "h5ds_scales": { "0": "/scales/axes/E" } },
        "/events/mesh_ref":      { "shape": ["E"], "dtype": "ref_dset_region", "target": "/manifold/vertex",
                                   "h5ds_scales": { "0": "/scales/axes/E" } }
      }
    },

    "/scales": {
      "groups": {
        "/scales/axes": {
          "datasets": {
            "/scales/axes/S": { "shape": ["S"], "dtype": "int64", "attributes": { "semantic": "stack", "labels": "string[]" } },
            "/scales/axes/C": { "shape": ["C"], "dtype": "int16", "attributes": { "semantic": "components", "labels": "string[]" } },
            "/scales/axes/N": { "shape": ["N"], "dtype": "int64", "attributes": { "semantic": "vertex_index" } },
            "/scales/axes/T": { "shape": ["T"], "dtype": "int64", "attributes": { "semantic": "time", "units": "sample", "sampling_rate_hz": "number", "t0_sec": "number" } },
            "/scales/axes/F": { "shape": ["F"], "dtype": "int64", "attributes": { "semantic": "face_index" } },
            "/scales/axes/K": { "shape": ["K"], "dtype": "int64", "attributes": { "semantic": "spatial_mode_index", "laplacian": "string" } },
            "/scales/axes/E": { "shape": ["E"], "dtype": "int64", "attributes": { "semantic": "event_row_index" } }
          }
        },
        "/scales/time":  { "attributes": { "note": "string" } },
        "/scales/space": { "attributes": { "note": "string" } }
      }
    }
  },

  "constraints": {
    "faces_ccw": true,
    "face_indices_in_range": true,
    "csr_shapes_match": true,
    "labels_utf8": true,
    "booleans_as_uint8": true,
    "dimension_scales_present": true,
    "subject_id_required": true,
    "subject_attributes_additional_ok": true,
    "cohort_links_optional": true
  },

  "storage_notes": {
    "subject_mapping": "Store subject.id as root attribute 'id'. Store each subject.attributes[i] as a root attribute with key=attributes[i].name and value encoded per attributes[i].dtype.",
    "cohort_mapping":  "Cohort may be stored as a root-level VLEN UTF-8 JSON dataset '/cohort' (array of link objects) or as a JSON attribute 'cohort' if your writer supports large JSON attributes."
  }
}
