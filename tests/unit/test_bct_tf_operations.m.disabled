function tests = test_bct_tf_operations
% test_bct_tf_operations - Test time-frequency domain operations and transforms
% Tests: FFT operations, spectral analysis, TF data handling
    tests = functiontests(localfunctions);
end

function setupOnce(testCase)
    % Add bioctree to path
    addpath(genpath(fullfile(fileparts(mfilename('fullpath')), '..', '..')));
    
    % Setup temporary directory
    testCase.TestData.tempDir = fullfile(tempdir, 'bct_tf_tests');
    if ~exist(testCase.TestData.tempDir, 'dir')
        mkdir(testCase.TestData.tempDir);
    end
end

function teardownOnce(testCase)
    % Cleanup temporary directory
    if exist(testCase.TestData.tempDir, 'dir')
        rmdir(testCase.TestData.tempDir, 's');
    end
end

function test_write_read_tf_basic(testCase)
    % Test: Basic TF write and read operations
    testFile = fullfile(testCase.TestData.tempDir, 'tf_basic.h5');
    
    % Create file and write TF data
    B = bct.bct.create(testFile);
    
    % Create synthetic TF data (F×T×N complex)
    F = 8; T = 16; N = 4;
    
    % Create complex TF data with known pattern
    TF = complex(single(zeros(F, T, N)));
    for f = 1:F
        for t = 1:T
            for n = 1:N
                % Real part encodes indices, imaginary part encodes position
                TF(f, t, n) = complex(f*100 + t*10 + n, f*0.1 + t*0.01 + n*0.001);
            end
        end
    end
    
    fs = 100;
    freqs = linspace(1, 50, F);
    
    % Write TF data
    B.write_tf(TF, fs, freqs);
    
    % Read back and verify
    [TF_read, fs_read, freqs_read] = B.read_tf();
    
    verifyEqual(testCase, TF_read, TF, 'AbsTol', 1e-6, 'TF data should match');
    verifyEqual(testCase, fs_read, fs, 'Sampling rate should match');
    verifyEqual(testCase, freqs_read, freqs, 'AbsTol', 1e-6, 'Frequencies should match');
    verifyClass(testCase, TF_read, 'single', 'TF data should be single precision');
    
    % Cleanup
    delete(testFile);
end

function test_tf_windowed_operations(testCase)
    % Test: TF operations with time/frequency windows
    testFile = fullfile(testCase.TestData.tempDir, 'tf_windows.h5');
    
    % Setup TF data
    B = bct.bct.create(testFile);
    F = 12; T = 20; N = 6;
    fs = 200;
    freqs = linspace(2, 60, F);
    
    % Create TF data with amplitude modulation pattern
    TF = complex(single(zeros(F, T, N)));
    for f = 1:F
        for t = 1:T
            for n = 1:N
                % Amplitude increases with frequency, modulated in time
                amp = f * (1 + 0.5 * cos(2*pi*t/T));
                phase = 2*pi*rand();  % Random phase
                TF(f, t, n) = single(amp * exp(1i*phase));
            end
        end
    end
    
    B.write_tf(TF, fs, freqs);
    
    % Test frequency window
    f_indices = 3:8;
    [TF_fwin, ~, freqs_fwin] = B.read_tf([], [], f_indices);
    expected_TF_fwin = TF(f_indices, :, :);
    expected_freqs_fwin = freqs(f_indices);
    
    verifyEqual(testCase, TF_fwin, expected_TF_fwin, 'AbsTol', 1e-6, 'Frequency window should match');
    verifyEqual(testCase, freqs_fwin, expected_freqs_fwin, 'AbsTol', 1e-6, 'Frequency window freqs should match');
    verifyEqual(testCase, size(TF_fwin), [6, T, N], 'Frequency window dimensions');
    
    % Test time window
    t_indices = [5, 15];
    [TF_twin, ~, ~] = B.read_tf(t_indices, []);
    expected_TF_twin = TF(:, 5:15, :);
    
    verifyEqual(testCase, TF_twin, expected_TF_twin, 'AbsTol', 1e-6, 'Time window should match');
    verifyEqual(testCase, size(TF_twin), [F, 11, N], 'Time window dimensions');
    
    % Test node selection
    node_indices = [2, 4, 6];
    [TF_nwin, ~, ~] = B.read_tf([], node_indices);
    expected_TF_nwin = TF(:, :, node_indices);
    
    verifyEqual(testCase, TF_nwin, expected_TF_nwin, 'AbsTol', 1e-6, 'Node selection should match');
    verifyEqual(testCase, size(TF_nwin), [F, T, 3], 'Node selection dimensions');
    
    % Test combined windows
    [TF_combined, ~, freqs_combined] = B.read_tf([8, 18], [1, 3, 5], [2:2:10]);
    expected_combined = TF(2:2:10, 8:18, [1, 3, 5]);
    expected_freqs_combined = freqs(2:2:10);
    
    verifyEqual(testCase, TF_combined, expected_combined, 'AbsTol', 1e-6, 'Combined windows should match');
    verifyEqual(testCase, freqs_combined, expected_freqs_combined, 'AbsTol', 1e-6, 'Combined freqs should match');
    verifyEqual(testCase, size(TF_combined), [5, 11, 3], 'Combined windows dimensions');
    
    % Cleanup
    delete(testFile);
end

function test_tf_spectral_properties(testCase)
    % Test: Verify spectral properties and complex number handling
    testFile = fullfile(testCase.TestData.tempDir, 'tf_spectral.h5');
    
    % Create file with known spectral content
    B = bct.bct.create(testFile);
    F = 16; T = 32; N = 2;
    fs = 128;
    freqs = linspace(0, fs/2, F);
    
    % Create TF data representing pure tones
    TF = complex(single(zeros(F, T, N)));
    
    % Node 1: Pure tone at frequency index 5
    tone_freq_idx = 5;
    TF(tone_freq_idx, :, 1) = single(10 * exp(1i * 2*pi*freqs(tone_freq_idx)*(0:T-1)/fs));
    
    % Node 2: Pure tone at frequency index 10 with different amplitude
    tone_freq_idx2 = 10;
    TF(tone_freq_idx2, :, 2) = single(5 * exp(1i * 2*pi*freqs(tone_freq_idx2)*(0:T-1)/fs + pi/4));
    
    B.write_tf(TF, fs, freqs);
    
    % Read and verify spectral content
    [TF_read, fs_read, freqs_read] = B.read_tf();
    
    verifyEqual(testCase, TF_read, TF, 'AbsTol', 1e-5, 'Complex TF should be preserved');
    verifyEqual(testCase, fs_read, fs, 'Sampling rate preserved');
    verifyEqual(testCase, freqs_read, freqs, 'AbsTol', 1e-6, 'Frequencies preserved');
    
    % Verify power spectral density patterns
    PSD = abs(TF_read).^2;
    
    % Node 1 should have peak at frequency index 5
    [~, peak_idx_1] = max(PSD(:, 1, 1));
    verifyEqual(testCase, peak_idx_1, tone_freq_idx, 'Node 1 peak should be at correct frequency');
    
    % Node 2 should have peak at frequency index 10
    [~, peak_idx_2] = max(PSD(:, 1, 2));
    verifyEqual(testCase, peak_idx_2, tone_freq_idx2, 'Node 2 peak should be at correct frequency');
    
    % Verify amplitude relationships
    amp1 = abs(TF_read(tone_freq_idx, 1, 1));
    amp2 = abs(TF_read(tone_freq_idx2, 1, 2));
    verifyEqual(testCase, amp1, single(10), 'AbsTol', 1e-5, 'Node 1 amplitude should be 10');
    verifyEqual(testCase, amp2, single(5), 'AbsTol', 1e-5, 'Node 2 amplitude should be 5');
    
    % Cleanup
    delete(testFile);
end

function test_tf_multiple_layers(testCase)
    % Test: TF operations with multiple layers/epochs
    testFile = fullfile(testCase.TestData.tempDir, 'tf_layers.h5');
    
    % Setup base TF data
    B = bct.bct.create(testFile);
    F = 6; T = 10; N = 3;
    fs = 50;
    freqs = linspace(5, 25, F);
    
    % Base layer: low frequency content
    TF_base = complex(single(rand(F, T, N)));
    TF_base(1:2, :, :) = TF_base(1:2, :, :) * 10;  % Enhance low freqs
    B.write_tf(TF_base, fs, freqs);
    
    % Add second layer: high frequency content  
    TF_layer1 = complex(single(rand(F, T, N)));
    TF_layer1(4:6, :, :) = TF_layer1(4:6, :, :) * 10;  % Enhance high freqs
    B.append_tf_layer(TF_layer1, 0);
    
    % Add third layer: mid frequency content
    TF_layer2 = complex(single(rand(F, T, N)));
    TF_layer2(3:4, :, :) = TF_layer2(3:4, :, :) * 10;  % Enhance mid freqs
    B.append_tf_layer(TF_layer2, 1);
    
    % Test reading different layers
    [TF_default, ~, ~] = B.read_tf();
    verifyEqual(testCase, size(TF_default), [F, T, N], 'Default layer dimensions');
    
    % Test reading specific layer
    [TF_specific, ~, ~] = B.read_tf([], [], [], 1);  % Layer 1
    verifyEqual(testCase, size(TF_specific), [1, F, T, N], 'Specific layer should be 1×F×T×N');
    TF_specific_squeezed = squeeze(TF_specific);
    verifyEqual(testCase, size(TF_specific_squeezed), [F, T, N], 'Squeezed layer dimensions');
    
    % Test that different layers have different content
    TF_layer1_read = squeeze(B.read_tf([], [], [], 1));
    TF_layer2_read = squeeze(B.read_tf([], [], [], 2));
    
    % Verify they're different (should fail equality test)
    verifyNotEqual(testCase, TF_layer1_read, TF_layer2_read, 'Different layers should have different content');
    
    % Cleanup
    delete(testFile);
end

function test_tf_frequency_axis_consistency(testCase)
    % Test: Ensure frequency axis consistency and proper scaling
    testFile = fullfile(testCase.TestData.tempDir, 'tf_freq_axis.h5');
    
    % Test different frequency axis configurations
    B = bct.bct.create(testFile);
    F = 10; T = 8; N = 2;
    fs = 100;
    
    % Test 1: Linear frequency spacing
    freqs_linear = linspace(1, fs/2, F);
    TF1 = complex(single(ones(F, T, N)));
    B.write_tf(TF1, fs, freqs_linear);
    
    [~, fs1, freqs1] = B.read_tf();
    verifyEqual(testCase, freqs1, freqs_linear, 'AbsTol', 1e-6, 'Linear frequencies should be preserved');
    verifyEqual(testCase, fs1, fs, 'Sampling rate should be preserved');
    
    % Verify frequency resolution
    expected_df = freqs_linear(2) - freqs_linear(1);
    actual_df = freqs1(2) - freqs1(1);
    verifyEqual(testCase, actual_df, expected_df, 'AbsTol', 1e-6, 'Frequency resolution should be consistent');
    
    % Test 2: Log frequency spacing
    freqs_log = logspace(log10(1), log10(fs/2), F);
    TF2 = complex(single(2*ones(F, T, N)));
    
    % Create new file for log frequencies
    testFile2 = fullfile(testCase.TestData.tempDir, 'tf_freq_log.h5');
    B2 = bct.bct.create(testFile2);
    B2.write_tf(TF2, fs, freqs_log);
    
    [~, fs2, freqs2] = B2.read_tf();
    verifyEqual(testCase, freqs2, single(freqs_log), 'AbsTol', 1e-5, 'Log frequencies should be preserved');
    verifyEqual(testCase, fs2, fs, 'Sampling rate should be preserved');
    
    % Verify log spacing property
    log_ratios = freqs2(2:end) ./ freqs2(1:end-1);
    expected_ratio = freqs_log(2) / freqs_log(1);
    verifyEqual(testCase, log_ratios, expected_ratio*ones(size(log_ratios), 'single'), ...
                'RelTol', 1e-5, 'Log spacing ratios should be consistent');
    
    % Cleanup
    delete(testFile);
    delete(testFile2);
end

function test_tf_complex_precision(testCase)
    % Test: Complex number precision and edge cases
    testFile = fullfile(testCase.TestData.tempDir, 'tf_complex.h5');
    
    B = bct.bct.create(testFile);
    F = 4; T = 6; N = 2;
    fs = 64;
    freqs = [1, 5, 15, 30];
    
    % Create TF data with specific complex values
    TF = complex(single(zeros(F, T, N)));
    
    % Test various complex number patterns
    TF(1, :, 1) = single(1 + 0i);           % Real only
    TF(2, :, 1) = single(0 + 1i);           % Imaginary only  
    TF(3, :, 1) = single(1 + 1i);           % Equal real/imaginary
    TF(4, :, 1) = single(-1 - 1i);          % Negative complex
    
    TF(1, :, 2) = single(exp(1i*pi/4));     % Unit magnitude, pi/4 phase
    TF(2, :, 2) = single(2*exp(1i*pi/2));   % Magnitude 2, pi/2 phase
    TF(3, :, 2) = single(0.5*exp(1i*pi));   % Magnitude 0.5, pi phase
    TF(4, :, 2) = single(3*exp(-1i*pi/3));  % Magnitude 3, -pi/3 phase
    
    B.write_tf(TF, fs, freqs);
    
    % Read and verify complex precision
    [TF_read, ~, ~] = B.read_tf();
    
    verifyEqual(testCase, TF_read, TF, 'AbsTol', 1e-7, 'Complex values should be precise');
    
    % Verify specific complex properties
    verifyEqual(testCase, real(TF_read(1, 1, 1)), single(1), 'AbsTol', 1e-7, 'Real part precision');
    verifyEqual(testCase, imag(TF_read(2, 1, 1)), single(1), 'AbsTol', 1e-7, 'Imaginary part precision');
    
    % Verify magnitude and phase preservation
    mag_original = abs(TF(1, 1, 2));
    mag_read = abs(TF_read(1, 1, 2));
    verifyEqual(testCase, mag_read, mag_original, 'AbsTol', 1e-6, 'Magnitude should be preserved');
    
    phase_original = angle(TF(1, 1, 2));
    phase_read = angle(TF_read(1, 1, 2));
    verifyEqual(testCase, phase_read, phase_original, 'AbsTol', 1e-6, 'Phase should be preserved');
    
    % Cleanup
    delete(testFile);
end