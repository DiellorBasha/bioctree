function tests = test_bct_smoke
% test_bct_smoke - Smoke tests for BCT class basic functionality
% Tests: Create → Open → Validate workflow
    tests = functiontests(localfunctions);
end

function setupOnce(testCase)
    % Add bioctree to path
    addpath(genpath(fullfile(fileparts(mfilename('fullpath')), '..', '..')));
    
    % Setup temporary directory for test files
    testCase.TestData.tempDir = fullfile(tempdir, 'bct_smoke_tests');
    if ~exist(testCase.TestData.tempDir, 'dir')
        mkdir(testCase.TestData.tempDir);
    end
end

function teardownOnce(testCase)
    % Cleanup temporary directory
    if exist(testCase.TestData.tempDir, 'dir')
        rmdir(testCase.TestData.tempDir, 's');
    end
end

function test_create_fresh_file(testCase)
    % Test: bct.create works on fresh file
    testFile = fullfile(testCase.TestData.tempDir, 'smoke_create.h5');
    
    % Ensure file doesn't exist
    if exist(testFile, 'file')
        delete(testFile);
    end
    
    % Create BCT object
    B = bct.bct.create(testFile);
    
    % Verify object properties
    verifyClass(testCase, B, 'bct.bct');
    verifyTrue(testCase, exist(char(B.fn), 'file'), 'BCT file should exist after creation');
    verifyTrue(testCase, isnan(B.T), 'T should be NaN for fresh file');
    verifyTrue(testCase, isnan(B.N), 'N should be NaN for fresh file');
    verifyFalse(testCase, B.has_raw, 'has_raw should be false for fresh file');
    verifyFalse(testCase, B.has_stack, 'has_stack should be false for fresh file');
    
    % Cleanup
    delete(testFile);
end

function test_open_created_file(testCase)
    % Test: bct.open works on created file
    testFile = fullfile(testCase.TestData.tempDir, 'smoke_open.h5');
    
    % Create then close
    B1 = bct.bct.create(testFile);
    clear B1;
    
    % Open the file
    B2 = bct.bct.open(char(testFile));
    
    % Verify object properties
    verifyClass(testCase, B2, 'bct.bct');
    verifyEqual(testCase, string(B2.fn), string(testFile), 'Filename should match');
    verifyTrue(testCase, isstruct(B2.schema), 'Schema should be loaded');
    
    % Cleanup
    delete(testFile);
end

function test_validate_fresh_file(testCase)
    % Test: B.validate() works on fresh file
    testFile = fullfile(testCase.TestData.tempDir, 'smoke_validate.h5');
    
    % Create BCT file
    B = bct.bct.create(testFile);
    
    % Validate should pass for fresh file
    report = B.validate();
    
    % Verify validation report structure
    verifyTrue(testCase, isstruct(report), 'Validation report should be a struct');
    
    % Cleanup
    delete(testFile);
end

function test_utility_methods_exist(testCase)
    % Test: New utility methods from patch are available
    testFile = fullfile(testCase.TestData.tempDir, 'smoke_utils.h5');
    
    % Create BCT file
    B = bct.bct.create(testFile);
    
    % Verify utility methods exist
    verifyTrue(testCase, ismethod(B, 'read_axis'), 'read_axis method should exist');
    verifyTrue(testCase, ismethod(B, 'has'), 'has method should exist');
    verifyTrue(testCase, ismethod(B, 'read_coords'), 'read_coords method should exist');
    verifyTrue(testCase, ismethod(B, 'read_graph_gsp'), 'read_graph_gsp method should exist');
    
    % Test has() method with non-existent path
    hasResult = B.has('/nonexistent/path');
    verifyFalse(testCase, hasResult, 'has() should return false for non-existent path');
    
    % Test read_coords() on empty file
    coords = B.read_coords();
    verifyEmpty(testCase, coords, 'read_coords should return empty for file without coordinates');
    
    % Cleanup
    delete(testFile);
end

function test_constant_paths_structure(testCase)
    % Test: Constant paths structure P exists and has expected fields
    testFile = fullfile(testCase.TestData.tempDir, 'smoke_paths.h5');
    
    % Create BCT file
    B = bct.bct.create(testFile);
    
    % Access constant paths through class (indirect test)
    % We can't directly access private constants, but we can test their effects
    
    % The presence of utility methods implies P structure exists
    verifyTrue(testCase, ismethod(B, 'has'), 'Utility methods imply P structure exists');
    
    % Cleanup  
    delete(testFile);
end