{
  "name": "bct-ui",
  "version": "2.0.0",
  "description": "Tailwind + D3.js based UI design system for BCT Toolbox",
  "scripts": {
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./dist/bct-ui.css --minify",
    "build:js": "node esbuild.config.mjs",
    "build": "npm run build:css && npm run build:js",
    "watch:css": "tailwindcss -i ./src/tailwind.css -o ./dist/bct-ui.css --watch",
    "watch:js": "esbuild ../src/js/index.js --bundle --outfile=./dist/bct-ui.js --watch",
    "watch": "npm run watch:css & npm run watch:js",
    "dev": "npm run build"
  },
  "keywords": [
    "tailwind",
    "d3",
    "ui",
    "matlab",
    "components",
    "visualization"
  ],
  "author": "BCT Toolbox",
  "license": "MIT",
  "dependencies": {
    "d3": "^7.9.0"
  },
  "devDependencies": {
    "esbuild": "^0.19.0",
    "tailwindcss": "^3.4.0"
  }
}
