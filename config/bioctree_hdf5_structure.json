{
  "bioctree_hdf5_structure": {
    "version": "1.1",
    "description": "Bioctree HDF5 file structure specification with Fourier basis support",
    "last_modified": "2025-10-22",
    
    "groups": {
      "/metadata": {
        "description": "Analysis metadata and parameters",
        "datasets": {
          "description": {
            "datatype": "string",
            "description": "Analysis description"
          },
          "creation_date": {
            "datatype": "string", 
            "description": "File creation timestamp"
          },
          "signal_type": {
            "datatype": "string",
            "description": "Type of signal data"
          },
          "coordinate_system": {
            "datatype": "string",
            "description": "Coordinate reference system"
          }
        }
      },
      
      "/graph": {
        "description": "Graph structure and topology",
        "datasets": {
          "coordinates": {
            "datatype": "single",
            "dimensions": ["N", 3],
            "description": "Vertex coordinates (x, y, z)",
            "required": true
          },
          "adjacency": {
            "datatype": "single", 
            "dimensions": ["N", "N"],
            "description": "Graph adjacency matrix",
            "compression": 6,
            "sparse": true,
            "required": false
          },
          "edges": {
            "datatype": "uint32",
            "dimensions": ["Ne", 2], 
            "description": "Edge list (vertex pairs)",
            "required": false
          },
          "edge_weights": {
            "datatype": "single",
            "dimensions": ["Ne"],
            "description": "Edge weights",
            "required": false
          },
          "eigenvalues": {
            "datatype": "single",
            "dimensions": ["N"],
            "description": "Laplacian eigenvalues (spectrum)",
            "compression": 6,
            "required": false,
            "fourier_basis": true
          },
          "eigenvectors": {
            "datatype": "single", 
            "dimensions": ["N", "N"],
            "description": "Laplacian eigenvectors (Fourier basis)",
            "compression": 6,
            "chunk_size": [50, 50],
            "required": false,
            "fourier_basis": true
          },
          "laplacian": {
            "datatype": "single",
            "dimensions": ["N", "N"],
            "description": "Graph Laplacian matrix", 
            "compression": 6,
            "sparse": true,
            "required": false
          }
        }
      },
      
      "/temporal": {
        "description": "Temporal information and sampling",
        "datasets": {
          "sampling_rate": {
            "datatype": "single",
            "description": "Temporal sampling rate (Hz)"
          },
          "time_points": {
            "datatype": "single",
            "dimensions": ["T"],
            "description": "Time point values"
          },
          "duration": {
            "datatype": "single", 
            "description": "Total duration (seconds)"
          }
        }
      },
      
      "/data": {
        "description": "Signal data at different processing stages",
        "subgroups": {
          "/data/raw": {
            "description": "Raw and preprocessed signals",
            "datasets": {
              "signal": {
                "datatype": "single",
                "dimensions": ["N", "T"],
                "description": "Primary graph signal",
                "compression": 6,
                "chunk_size": [50, 50],
                "required": false
              }
            },
            "dynamic_datasets": {
              "signal_*": {
                "datatype": "single", 
                "dimensions": ["N", "T"],
                "description": "Named signal layers",
                "compression": 6,
                "chunk_size": [50, 50]
              },
              "signal_###": {
                "datatype": "single",
                "dimensions": ["N", "T"],
                "description": "Numbered signal layers",
                "compression": 6,
                "chunk_size": [50, 50]
              }
            }
          },
          
          "/data/spectral": {
            "description": "Spectral decompositions and transforms", 
            "datasets": {
              "signal_gft": {
                "datatype": "single",
                "dimensions": ["N", "T"],
                "description": "Graph Fourier Transform coefficients",
                "compression": 6,
                "chunk_size": [50, 50],
                "required": false
              }
            },
            "dynamic_datasets": {
              "*_gft": {
                "datatype": "single",
                "dimensions": ["N", "T"], 
                "description": "GFT coefficients for named signals",
                "compression": 6,
                "chunk_size": [50, 50]
              }
            }
          },
          
          "/data/derived": {
            "description": "Derived analysis results",
            "datasets": {}
          }
        }
      },
      
      "/indices": {
        "description": "Indexing for efficient querying",
        "subgroups": {
          "/indices/time_indices": {
            "description": "Temporal indexing structures"
          },
          "/indices/spatial_indices": {
            "description": "Spatial indexing structures" 
          },
          "/indices/frequency_indices": {
            "description": "Spectral indexing structures"
          }
        }
      },
      
      "/analysis": {
        "description": "Analysis results and statistics",
        "subgroups": {
          "/analysis/statistics": {
            "description": "Statistical analysis results"
          },
          "/analysis/decompositions": {
            "description": "Matrix decomposition results"
          },
          "/analysis/detection": {
            "description": "Pattern detection results"
          }
        }
      }
    },
    
    "creation_options": {
      "default_compression": 6,
      "default_chunk_size": [50, 50],
      "default_datatype": "single",
      "cleanup_temp_datasets": true
    },
    
    "validation_rules": {
      "required_groups": ["/metadata", "/graph", "/temporal", "/data", "/indices", "/analysis"],
      "required_datasets": ["/graph/coordinates"],
      "coordinate_dimensions": 3,
      "graph_consistency": {
        "check_vertex_count": true,
        "check_edge_validity": true,
        "check_fourier_basis_size": true
      }
    }
  }
}