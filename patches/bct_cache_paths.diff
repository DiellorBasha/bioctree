+                 else
+                     nAxis = numel(h5read(this.fn, this.P.axes_node));
+                     assert(nAxis==N, "bct:NodeCountMismatch","Signal N=%d vs node_id=%d",N,nAxis);
+                 end
+                 if ~bct.internal.Util.pathExists(this.fn, this.P.axes_time)
+                     h5create(this.fn, this.P.axes_time, [T 1], 'Datatype','double');
+                     h5write(this.fn,  this.P.axes_time, (0:T-1)'/fs);
+                 else
+                     tAxis = numel(h5read(this.fn, this.P.axes_time));
+                     assert(tAxis==T, "bct:TimeLengthMismatch","Signal T=%d vs time_s=%d",T,tAxis);
+                 end
+                 h5create(this.fn, this.P.raw, [T N], 'Datatype','single', ...
+                     'ChunkSize', [min(T,2048) min(N,256)], 'Deflate',5, 'Shuffle',true);
+                 bct.internal.DimScale.attach(this.fn, this.P.raw, ...
+                     {this.P.axes_time, this.P.axes_node}, {'time_s','node_id'});
+                 h5writeatt(this.fn,'/','fs_hz', single(fs));
+                 this.has_raw = true;
+             else
+                 % Already initialized: assert against cached sizes
+                 assert(this.N==N && this.T==T, 'bct:ShapeMismatch','(T,N) must match existing axes.');
+             end
+ 
+             % Write & refresh caches
+             h5write(this.fn, this.P.raw, X);
+             this.T=T; this.N=N; this.fs=fs;
          end
