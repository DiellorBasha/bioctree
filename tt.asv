bioctree_start
path = 'test-data\freesurfer\fsaverage\surf\lh.pial';
B = bct.io.graph.Import.fromFreeSurfer(path);
% Now load curvature signal into the existing B object
curv_path = 'test-data\freesurfer\fsaverage\surf\lh.curv';  % Path to your curvature file
B = bct.io.signal.Import.fromFreeSurfer(curv_path, B);



Gmat=B.mgraph;
Gmesh = B.mesh;
G=gsp_graph(B.gsp.W, B.Vertices);
figure(1)
surfaceMeshShow(B.mesh)


fname = "data/test_LUT.h5";
if exist(fname,'file'), delete(fname); end

%% -------- Parameters (toy) --------
N = B.N;                  % number of vertices (toy)
T = 1;                  % static for now
S = 3;                  % signals: coords, normals, curvature
C = 3;                  % max components across signals (coords/normals=3, curvature uses 1)

 %Subject info
subj.label = 'SUBJ001';
subj.age   = int32(29);
subj.sex   = 'F';

%% -------- Make toy signals --------
% coords: simple ring in XY for clarity
theta = linspace(0, 2*pi, N+1); theta(end) = [];
coords = B.Vertices;          % [3,N]
% normals: outward in XY plane (same as coords here, unit length)
normals = B.mesh.VertexNormals;                                        % [3,N]

% curvature: toy scalar (e.g., cos wave)
curv = single(0.5 + 0.5*cos(theta));                     % [1,N]

% Pack into SNCT = [S,N,C,T] with C=3 (pad scalar with NaNs)
signals = nan(S, N, C, T, 'single');
% S=1: coords (x,y,z)
signals(1,:,1:3,1) = single(coords);    % coords' -> [N,3]
% S=2: normals (nx,ny,nz)
signals(2,:,1:3,1) = single(normals);   % [N,3]
% S=3: curvature (only component 1 used)
signals(3,:,1,1)   = single(curv);      % [N,1]


    % --- Build cotangent-weight adjacency & mass matrix ---
    [W_cot, M] = cot_weights(B.Vertices, B.Faces);
    % --- Build GSP graph (use cotangent adjacency as W, attach coords) ---
    G = gsp_graph(W_cot, B.Vertices);
    %G.type = 'mesh-cotangent';
    G.plotting.vertex_size = 1;
    G.Faces = B.Faces;
    G.M = M;                      % lumped vertex areas (mass)
             % [E,2] uint32
[i,j] = find(triu(G.A, 1));        % column vectors
E = int32([i j]);                % P×2 edge list (1-based)
size(E)
[i,j,w] = find(triu(G.W,1));
Ew = [int32(i) int32(j) single(w)];   % P×3 (i, j, w)
clear Gmat2
Gmat2=graph(i,j,w);
plot(Gmat2)
%% 

h5create(fname, '/signals/data', size(signals), 'Datatype', 'single');
h5write(fname,  '/signals/data', signals);

% /lut/edges
h5create(fname, '/lut/edges', size(edges), 'Datatype', 'uint32');
h5write(fname,  '/lut/edges', edges);



%% -------- Root attributes (subject) --------
h5writeatt(fname, '/', 'subject_label', subj.label);
h5writeatt(fname, '/', 'age',           subj.age);
h5writeatt(fname, '/', 'sex',           subj.sex);

index = struct( ...
  'axes',           "S,N,C,T", ...
  'signals', {{ ...
      struct('s',1,'name',"coords",    'role',"geometry", 'components',3, 'timeType',"static",'dtype',"float32"), ...
      struct('s',2,'name',"normals",   'role',"geometry", 'components',3, 'timeType',"static",'dtype',"float32"), ...
      struct('s',3,'name',"curvature", 'role',"metric",   'components',1, 'timeType',"static",'dtype',"float32") ...
  }} ...
);

% Encode as JSON (requires MATLAB R2020b+ for jsonencode)
index_json = jsonencode(index);

% Attach to /signals (group) as attribute; create group if missing
fid = H5F.open(fname,'H5F_ACC_RDWR','H5P_DEFAULT');
if ~H5L.exists(fid, '/signals', 'H5P_DEFAULT')
    gid = H5G.create(fid, '/signals', 'H5P_DEFAULT','H5P_DEFAULT','H5P_DEFAULT');
    H5G.close(gid);
end
H5F.close(fid);

h5writeatt(fname, '/signals', 'index_json', index_json);

%% -------- Helpful attributes on /signals/data --------
h5writeatt(fname, '/signals/data', 'order',     'S,N,C,T');
h5writeatt(fname, '/signals/data', 'dtype',     'float32');
h5writeatt(fname, '/signals/data', 'S', int32(S));
h5writeatt(fname, '/signals/data', 'N', int32(N));
h5writeatt(fname, '/signals/data', 'C', int32(C));
h5writeatt(fname, '/signals/data', 'T', int32(T));
